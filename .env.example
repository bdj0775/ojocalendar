# Supabase 설정 — Supabase Dashboard > Project Settings > API 에서 복사
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 토스페이먼츠 — developers.tosspayments.com > 내 개발센터 > API 키 > "API 개별 연동 키"
# 클라이언트 키는 프론트엔드에 노출되어도 되는 키. 시크릿 키는 절대 VITE_ 접두사 붙이지 말 것
# (VITE_ 접두사가 붙으면 브라우저 번들에 포함되어 누구나 볼 수 있게 됨 — Edge Function 환경변수로만 등록)
VITE_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx
